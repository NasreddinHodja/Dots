#!/usr/bin/env bash

notify-send "Normal notification" "This is a normal test."

notify-send -u low "Low urgency" "Just a low-urgency ping."

notify-send -u critical "Critical notification" "Something went VERY wrong!"

notify-send -i dialog-information "With icon" "This one has an icon."

for i in $(seq 0 20 100); do
    notify-send -h int:value:$i \
                -h string:x-dunst-stack-tag:test-progress \
                "Progress Test" \
                "progress: $i%"
    sleep 0.3
done

for i in 1 2 3 4; do
    notify-send -a "StackApp" "Duplicate Test" "Sent repeatedly, should stack as (x4) not 4 bubbles"
    sleep 0.3
done

notify-send -h string:desktop-entry:firefox \
            "Desktop-entry Icon Test" \
            "Should pick Firefox icon from theme"

notify-send -h string:x-canonical-private-synchronous:volume \
            "Replacing-notifications Test" \
            "This replaces the previous one with the same tag"

notify-send -t 2000 "Timeout Test" "This disappears after 2 seconds."

notify-send -a "TestApp" "App Name Test" "Dunst should show 'TestApp'"

notify-send -i dialog-warning \
            --action=default,Ok \
            --action=alt,Cancel \
            "Action Test" "Dunst must support actions (enable in config)."

# Heroic-style: a single "default" action with an empty label - this is
# the implicit click-to-activate action from the notification spec, sent
# with no label since it's not meant to render as its own button. Should
# show NO action chip; clicking the notification body should invoke it.
notify-send -a "Heroic Games Launcher" "Test Game" "Installation complete." \
            -A "default=" &

# Named action, non-resident: clicking "Reply" should invoke it and
# dismiss the bubble.
notify-send -a "TestApp" "Non-resident action" "Click Reply below." \
            -A "reply=Reply" &

# Named action, resident: clicking "Reply" should invoke it but the
# bubble must stay open (resident notifications only close when
# explicitly dismissed/closed, not just because an action fired).
# Sent via gdbus, not notify-send: notify-send is itself the "sender" in
# spec terms, and it explicitly calls CloseNotification the instant it
# gets an answer back (confirmed via dbus-monitor) - spec-legal cleanup,
# but it auto-closes the bubble regardless of the resident hint, which
# defeats the point of this test. gdbus fires the request and exits, so
# nothing is left listening to close it after the click.
gdbus call --session \
    --dest org.freedesktop.Notifications \
    --object-path /org/freedesktop/Notifications \
    --method org.freedesktop.Notifications.Notify \
    "TestApp" 0 "" "Resident action" \
    "Click Reply below - bubble should stay open." \
    "['reply', 'Reply']" "{'resident': <true>}" 0 > /dev/null &

echo "Done firing notifications."
