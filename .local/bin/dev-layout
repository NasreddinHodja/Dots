#!/usr/bin/env bash
# spawn kitty + an emacsclient frame on the main output, tile them left/right.
# placement is a kwin script (dev-layout.js) loaded over d-bus.
# the --class marker needs a matching dev-kitty.desktop or plasma shows the
# generic wayland icon instead of kitty's.

set -u

MAIN_OUTPUT="${DEV_LAYOUT_OUTPUT:-DP-3}"
DESKTOP="${DEV_LAYOUT_DESKTOP:-1}"   # 1-based, as shown in the pager
FOCUS_SIDE="${DEV_LAYOUT_FOCUS:-left}"

KITTY_CLASS="${DEV_LAYOUT_KITTY_CLASS:-dev-kitty}"
EMACS_FRAME="${DEV_LAYOUT_EMACS_FRAME:-dev-emacs}"

PLUGIN="${DEV_LAYOUT_PLUGIN:-dev-layout}"
JS="${XDG_RUNTIME_DIR:-/tmp}/$PLUGIN.js"

# resolve through the ~/.local/bin symlink
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SOURCE_JS="${DEV_LAYOUT_JS:-${SELF%/*}/dev-layout.js}"

die() { printf '%s: %s\n' "${0##*/}" "$*" >&2; exit 1; }

command -v qdbus6 >/dev/null || die "qdbus6 not found"
[[ ${XDG_CURRENT_DESKTOP:-} == *KDE* ]] || die "not a KDE session"
[[ -r $SOURCE_JS ]] || die "cannot read KWin script: $SOURCE_JS"

kwin() { qdbus6 org.kde.KWin /Scripting "org.kde.kwin.Scripting.$@"; }

# --- the kwin side ----------------------------------------------------------

# kwin scripts can't read config or files, so the settings go in as source
{
    printf 'const MAIN_OUTPUT   = "%s";\n' "$MAIN_OUTPUT"
    printf 'const DESKTOP_INDEX = %d;\n'   "$((DESKTOP - 1))"
    printf 'const FOCUS_SIDE    = "%s";\n' "$FOCUS_SIDE"
    printf 'const LEFT_CLASS    = "%s";\n' "$KITTY_CLASS"
    printf 'const RIGHT_TITLE   = "%s";\n' "$EMACS_FRAME"
    cat "$SOURCE_JS"
} > "$JS"

# reload, else re-runs stack listeners
kwin unloadScript "$PLUGIN" >/dev/null 2>&1
kwin loadScript "$JS" "$PLUGIN" >/dev/null || die "KWin refused the layout script"
kwin start >/dev/null

# --- the applications -------------------------------------------------------

if ! pgrep -f "kitty --class $KITTY_CLASS" >/dev/null; then
    kitty --class "$KITTY_CLASS" >/dev/null 2>&1 &
    disown
fi

if ! emacsclient -e '(emacs-pid)' >/dev/null 2>&1; then
    emacs --daemon >/dev/null 2>&1 || die "emacs daemon failed to start"
fi

has_frame=$(emacsclient -e \
    "(if (seq-find (lambda (f) (equal (frame-parameter f 'name) \"$EMACS_FRAME\")) (frame-list)) t nil)" \
    2>/dev/null)

if [[ $has_frame != t ]]; then
    emacsclient --alternate-editor= --create-frame --no-wait \
        --frame-parameters="((name . \"$EMACS_FRAME\"))" \
        "$@" >/dev/null 2>&1
fi
